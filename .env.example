# =============================================================================
# .env.example — Safe to commit. Copy to .env and fill in values.
# =============================================================================

APP_NAME="AIOps Pipeline RCA System"
ENVIRONMENT=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

MODEL_FILENAME=rca_model_v1.pkl

AIRFLOW_HOST=http://localhost:8080
RCA_API_URL=http://localhost:8000

TFIDF_MAX_FEATURES=50
